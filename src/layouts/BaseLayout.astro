---
import "../styles/global.css";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  showFooter?: boolean;
  seasonTransition?: boolean;
}

const {
  title,
  description = "Field notes on plants, ingredients and ancient cooking.",
  showFooter = true,
  seasonTransition = false,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {seasonTransition && <style is:inline>
      @view-transition { navigation: auto; }
      html:active-view-transition-type(ingredients-fade) ::view-transition-group(root),
      html:active-view-transition-type(ingredients-fade) ::view-transition-group(season-navigation) {
        animation-duration: 220ms;
      }
      html:active-view-transition-type(ingredients-fade) img,
      html:active-view-transition-type(ingredients-fade) .season-index {
        view-transition-name: none !important;
      }
      ::view-transition-group(season-cover-photo) {
        animation-duration: 350ms;
        animation-timing-function: cubic-bezier(.22, .7, .25, 1);
        z-index: 1;
      }
      ::view-transition-group(season-navigation),
      ::view-transition-group(season-heading) {
        animation-duration: 350ms;
        z-index: 2;
      }
    </style>}
    {seasonTransition && <script is:inline>
      function setIngredientsTransition(event, otherUrl) {
        if (!otherUrl) return;
        const path = new URL(otherUrl).pathname;
        if (/^\/ingredients\/?$/.test(location.pathname) || /^\/ingredients\/?$/.test(path)) {
          event.viewTransition?.types?.add("ingredients-fade");
        }
      }
      window.addEventListener("pageswap", (event) => {
        setIngredientsTransition(event, event.activation?.entry?.url);
      });
      window.addEventListener("pagereveal", (event) => {
        setIngredientsTransition(event, window.navigation?.activation?.from?.url);
      });
    </script>}
  </head>

  <body>
    <div class="page-flow">
      <slot />
    </div>
    {showFooter && <Footer />}
  </body>
</html>

<style>
  .page-flow {
    display: flex;
    flex: 1 0 auto;
    flex-direction: column;
    width: 100%;
  }
</style>
