<aside id="explore" class="section-transition" aria-label="Section transition">
  <div class="inner">
    <span>From landscape to table</span>
    <span class="range">01 — 03</span>
  </div>
</aside>

<script>
  const sectionTransition = document.querySelector("#explore");
  const exploreLinks = document.querySelectorAll('a[href="#explore"]');

  exploreLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      sectionTransition?.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    });
  });
</script>

<style>
  .section-transition {
    display: block;
    position: relative;
    z-index: 10;
    flex: 0 0 auto;
    width: 100%;
    height: 48px;
    min-height: 48px;
    margin: 0;
    overflow: hidden;
    scroll-margin-top: 0;
    box-sizing: border-box;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: #1b211d;
    color: #d8d8d1;
  }

  .inner {
    width: min(1120px, calc(100% - 48px));
    height: 100%;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-sizing: border-box;
    font-size: 12px;
    letter-spacing: 2px;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .range {
    color: rgba(216, 216, 209, 0.72);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .section-transition {
      height: 44px;
      min-height: 44px;
    }

    .inner {
      width: calc(100% - 32px);
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      font-size: 11px;
      letter-spacing: 1.4px;
    }
  }
</style>
