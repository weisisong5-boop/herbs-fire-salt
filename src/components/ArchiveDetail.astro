---
import ArchiveSurface from "./ArchiveSurface.astro";

interface Props {
  eyebrow: string;
  title: string;
  secondary?: string;
  description: string;
  cover: string;
}

const { eyebrow, title, secondary = "", description, cover } = Astro.props;
---

<ArchiveSurface>
  <article class="archive-detail">
    <header>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      {secondary && <p class="secondary">{secondary}</p>}
      <p class="summary">{description}</p>
    </header>

    <figure>
      <img src={cover} alt="" />
    </figure>

    <div class="content">
      <slot name="introduction" />
      <slot />
      <slot name="related" />
    </div>
  </article>
</ArchiveSurface>

<style>
  .archive-detail {
    width: 100%;
    margin: 0;
  }

  header {
    max-width: 860px;
    margin: 0 auto 64px;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 24px;
    color: var(--color-text-muted);
    font-size: 13px;
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--color-text-main);
    font-size: clamp(48px, 8vw, 88px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 2px;
  }

  .secondary {
    margin: 24px 0 0;
    color: var(--color-text-muted);
    font-size: 15px;
    letter-spacing: 1px;
    line-height: 1.6;
  }

  .summary {
    max-width: 680px;
    margin: 30px auto 0;
    color: var(--color-text-muted);
    font-size: 20px;
    line-height: 1.75;
  }

  figure {
    margin: 0 auto 72px;
  }

  img {
    display: block;
    width: 100%;
    max-height: 680px;
    object-fit: cover;
  }

  .content {
    max-width: 720px;
    margin: 0 auto;
    color: var(--color-text-main);
    font-size: 20px;
    line-height: 1.85;
  }

  .content :global(p) {
    margin: 0 0 28px;
  }

  @media (max-width: 720px) {
    header {
      margin-bottom: 48px;
    }

    figure {
      margin-bottom: 48px;
    }
  }
</style>
