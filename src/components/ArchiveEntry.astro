---
interface Props {
  href: string;
  eyebrow: string;
  title: string;
  secondary: string;
  description: string;
  image: string;
  imageAlt?: string;
}

const {
  href,
  eyebrow,
  title,
  secondary,
  description,
  image,
  imageAlt = "",
} = Astro.props;
---

<article class="archive-entry">
  <a href={href}>
    <div class="copy">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      <p class="secondary">{secondary}</p>
      <p class="description">{description}</p>
    </div>

    <img src={image} alt={imageAlt} />
  </a>
</article>

<style>
  .archive-entry {
    border-top: 1px solid var(--color-line);
  }

  .archive-entry:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 420px);
    gap: 48px;
    align-items: center;
    padding: 34px 0;
    color: var(--color-text-main);
    text-decoration: none;
  }

  .eyebrow {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 12px;
    letter-spacing: 2px;
    line-height: 1.5;
    text-transform: uppercase;
  }

  h2 {
    margin: 16px 0 0;
    color: var(--color-text-main);
    font-size: 34px;
    font-weight: 500;
    letter-spacing: 1px;
    line-height: 1.15;
  }

  .secondary {
    margin: 10px 0 0;
    color: var(--color-text-muted);
    font-size: 16px;
    line-height: 1.5;
  }

  .description {
    max-width: 620px;
    margin: 18px 0 0;
    color: var(--color-text-muted);
    font-size: 18px;
    line-height: 1.7;
  }

  img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  a:hover h2,
  a:focus-visible h2 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  @media (max-width: 720px) {
    a {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 28px 0;
    }

    img {
      order: -1;
    }

    h2 {
      font-size: 30px;
    }
  }
</style>
