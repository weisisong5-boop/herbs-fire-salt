---

---<section class="hero">
  <div class="hero-frame">
    <div class="content">

    <h1>
  HERBS<br />
  FIRE<br />
  SALT
 </h1>
<div class="edition">
FIELD JOURNAL · VOL.01
</div>
    <p>
      Field notes on plants,
      ingredients and ancient cooking.
    </p>

    <p class="location">
      云南山地 · Mediterranean shores
    </p>

    <a href="#explore">
      Explore the field
    </a>

    </div>
  </div>
</section>


<style>
  .edition {
    color: #ffffff;
    font-size: 13px;
    letter-spacing: 5px;
    margin-bottom: 30px;
    opacity: 0.86;
  }

  .hero {
    position: relative;
    isolation: isolate;
    display: block;
    width: 100%;
    min-height: calc(100vh - 90px);
    margin: 0;
    overflow: hidden;
    box-sizing: border-box;
    color: #ffffff;
    background: transparent;
    text-align: left;
  }

  .hero-frame {
    width: 100%;
    min-height: inherit;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 0 9vw;
    box-sizing: border-box;
  }

  .content {
    max-width: 700px;
    animation: fade-in 900ms ease-out both;
  }

h1 {
  color: #ffffff;
  font-family: Georgia, serif;
  font-size: 96px;
  line-height: 0.85;
  letter-spacing: 14px;
  font-weight: 400;
  text-transform: uppercase;
}

p {
  color: #ffffff;
  margin-top: 35px;
  font-size: 20px;
  line-height: 1.8;
}

.location {
  font-size: 16px;
  opacity: 0.82;
}

a {
  display: inline-block;
  margin-top: 58px;
  padding: 19px 48px;
  border: 1px solid #ffffff;
  color: #ffffff;
  font-size: 18px;
  text-decoration: none;
}

a:hover {
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
}

@keyframes fade-in {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 1024px) {
  .hero {
    min-height: calc(100dvh - 78px);
  }

  .hero-frame {
    padding: clamp(52px, 7dvh, 72px) 7vw;
  }

  h1 {
    margin: 0;
    font-size: 72px;
    letter-spacing: 9px;
  }

  .edition {
    margin-bottom: 20px;
  }

  p {
    margin-top: 24px;
  }

  a {
    margin-top: 36px;
  }
}

@media (max-width: 640px) {
  .hero {
    min-height: min(720px, 100svh);
    min-height: min(720px, 100dvh);
  }

  .hero-frame {
    padding: clamp(36px, 6dvh, 52px) 7vw;
  }

  h1 {
    font-size: clamp(50px, 15.5vw, 62px);
    letter-spacing: clamp(4px, 1.6vw, 7px);
  }

  .edition {
    margin-bottom: 28px;
    font-size: 11px;
    letter-spacing: 3px;
  }

  p {
    margin-top: 18px;
    font-size: 17px;
    line-height: 1.6;
  }

  .location {
    font-size: 14px;
  }

  a {
    margin-top: 38px;
  }
}
</style>
