---

---<section class="hero">
  <div class="content">

    <h1>
  HERBS<br />
  FIRE<br />
  SALT
 </h1>
<div class="edition">
FIELD JOURNAL · VOL.01
</div>
    <p>
      Field notes on plants,
      ingredients and ancient cooking.
    </p>

    <p class="location">
      云南山地 · Mediterranean shores
    </p>

    <a href="#explore">
      Explore the field
    </a>

  </div>
</section>


<style>
  .edition {
    color: #ffffff;
    font-size: 13px;
    letter-spacing: 5px;
    margin-bottom: 30px;
    opacity: 0.86;
  }

  .hero {
    min-height: calc(100vh - 90px);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 0 9vw;
    box-sizing: border-box;
    color: #ffffff;
    text-align: left;
    background:
      linear-gradient(
        90deg,
        rgba(10, 10, 8, 0.9) 0%,
        rgba(10, 10, 8, 0.68) 48%,
        rgba(10, 10, 8, 0.32) 100%
      ),
      url("/images/hero.jpg");
    background-size: cover;
    background-position: center;
  }

  .content {
    max-width: 700px;
    animation: fade-in 900ms ease-out both;
  }

h1 {
  color: #ffffff;
  font-family: Georgia, serif;
  font-size: 96px;
  line-height: 0.85;
  letter-spacing: 14px;
  font-weight: 400;
  text-transform: uppercase;
}

p {
  color: #ffffff;
  margin-top: 35px;
  font-size: 20px;
  line-height: 1.8;
}

.location {
  font-size: 16px;
  opacity: 0.82;
}

a {
  display: inline-block;
  margin-top: 58px;
  padding: 19px 48px;
  border: 1px solid #ffffff;
  color: #ffffff;
  font-size: 18px;
  text-decoration: none;
}

a:hover {
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
}

@keyframes fade-in {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}
</style>
