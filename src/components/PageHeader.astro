---
interface Props {
  title: string;
  subtitle: string;
  eyebrow: string;
}

const { title, subtitle, eyebrow } = Astro.props;
---

<main class="page-header">
  <div class="inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="subtitle">{subtitle}</p>
  </div>
</main>

<style>
  .page-header {
    min-height: 460px;
    display: flex;
    align-items: center;
    padding: 64px 0;
    box-sizing: border-box;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: #ffffff;
    background: transparent;
    text-align: left;
  }

  .inner {
    width: min(1120px, calc(100% - 48px));
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: rgba(255, 255, 255, 0.76);
    font-size: 13px;
    letter-spacing: 4px;
    line-height: 1.4;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: #ffffff;
    font-size: 64px;
    letter-spacing: 3px;
    font-weight: 400;
  }

  .subtitle {
    max-width: 620px;
    margin: 24px 0 0;
    color: rgba(255, 255, 255, 0.84);
    font-size: 20px;
    line-height: 1.8;
  }

  @media (max-width: 640px) {
    .page-header {
      min-height: 350px;
      padding: 44px 0;
    }

    .inner {
      width: calc(100% - 32px);
    }

    .eyebrow {
      margin-bottom: 14px;
      font-size: 11px;
      letter-spacing: 3px;
    }

    h1 {
      font-size: clamp(42px, 13vw, 56px);
      letter-spacing: clamp(1px, 1vw, 3px);
      overflow-wrap: anywhere;
    }

    .subtitle {
      margin-top: 18px;
      font-size: 17px;
      line-height: 1.6;
    }
  }
</style>
