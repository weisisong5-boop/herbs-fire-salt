---
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? currentPath === href : currentPath.startsWith(href);

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
---
<nav class:list={["navbar", { "navbar--transparent": transparent }]}>
  <a href="/" class="logo">
    Herbs - Fire - Salt
  </a>

  <div class="links">
    <a href="/" aria-current={isCurrent("/") || isCurrent("/recipes/") ? "page" : undefined}>Recipes</a>
    <a href="/ingredients/" aria-current={isCurrent("/ingredients/") ? "page" : undefined}>Ingredients</a>
    <a href="/field-notes/" aria-current={isCurrent("/field-notes/") ? "page" : undefined}>Dish Inspiration</a>
  </div>
</nav>

<style>
  .navbar {
    width: 100%;
    padding: 30px 60px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-sizing: border-box;
    background: transparent;
  }

  .navbar--transparent {
    text-shadow: 0 1px 8px #171b13;
  }

  .logo {
    --nav-link-color: #f3f0e8;
    color: #f3f0e8;
    font-family: Georgia, serif;
    font-size: 24px;
    letter-spacing: 2px;
  }

  .links {
    display: flex;
    gap: 35px;
  }

  a {
    color: var(--nav-link-color);
    text-decoration: none;
    font-size: 15px;
    letter-spacing: 1px;
  }

  .links a:nth-child(1) {
    --nav-link-color: #f3c443;
  }

  .links a:nth-child(2) {
    --nav-link-color: #a8d982;
  }

  .links a:nth-child(3) {
    --nav-link-color: #82d4c6;
  }

  .navbar:not(.navbar--transparent) a {
    --nav-link-color: var(--color-text-main);
  }

  a:hover,
  a:focus-visible,
  a[aria-current="page"] {
    color: var(--nav-link-color);
    opacity: 1;
  }

  a[aria-current="page"] {
    text-decoration-line: underline;
    text-decoration-color: currentColor;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  @media (max-width: 1024px) {
    .navbar {
      padding: 24px 32px;
    }

    .links {
      gap: 20px;
    }

    a {
      font-size: 14px;
    }
  }

  @media (max-width: 640px) {
    .navbar {
      flex-wrap: wrap;
      gap: 20px;
      padding: 20px 16px;
    }

    .logo {
      width: 100%;
    }

    .links {
      width: 100%;
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 0;
    }

    a {
      font-size: clamp(12px, 3.2vw, 14px);
    }
  }
</style>
