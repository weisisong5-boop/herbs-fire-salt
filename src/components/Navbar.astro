---
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? currentPath === href : currentPath.startsWith(href);

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
---
<nav class:list={["navbar", { "navbar--transparent": transparent }]}>
  <div class="logo">
    Herbs - Fire - Salt
  </div>

  <div class="links">
    <a href="/" aria-current={isCurrent("/") ? "page" : undefined}>Home</a>
    <a href="/field-notes/" aria-current={isCurrent("/field-notes/") ? "page" : undefined}>Field Notes</a>
    <a href="/ingredients/" aria-current={isCurrent("/ingredients/") ? "page" : undefined}>Ingredients</a>
    <a href="/recipes/" aria-current={isCurrent("/recipes/") ? "page" : undefined}>Recipes</a>
    <a href="/about/" aria-current={isCurrent("/about/") ? "page" : undefined}>About</a>
  </div>
</nav>

<style>
  .navbar {
    width: 100%;
    padding: 30px 60px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-sizing: border-box;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background:
      linear-gradient(
        180deg,
        rgba(236, 242, 248, 0.025) 0%,
        rgba(12, 21, 34, 0.16) 100%
      ),
      linear-gradient(
        90deg,
        #34495f 0%,
        #3d566d 38%,
        #49657d 72%,
        #58758d 100%
      );
  }

  .navbar--transparent {
    border-bottom-color: transparent;
    background: transparent;
  }

  .logo {
    color: #f3f0e8;
    font-family: Georgia, serif;
    font-size: 24px;
    letter-spacing: 2px;
  }

  .links {
    display: flex;
    gap: 35px;
  }

  a {
    color: var(--nav-link-color);
    text-decoration: none;
    font-size: 15px;
    letter-spacing: 1px;
  }

  .links a:nth-child(1) {
    --nav-link-color: #f3c443;
  }

  .links a:nth-child(2) {
    --nav-link-color: #a8d982;
  }

  .links a:nth-child(3) {
    --nav-link-color: #82d4c6;
  }

  .links a:nth-child(4) {
    --nav-link-color: #e8e84f;
  }

  .links a:nth-child(5) {
    --nav-link-color: #f3f0e8;
  }

  a:hover,
  a:focus-visible,
  a[aria-current="page"] {
    color: var(--nav-link-color);
    opacity: 1;
  }

  a[aria-current="page"] {
    text-decoration-line: underline;
    text-decoration-color: currentColor;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  @media (max-width: 1024px) {
    .navbar {
      padding: 24px 32px;
    }

    .links {
      gap: 20px;
    }

    a {
      font-size: 14px;
    }
  }

  @media (max-width: 640px) {
    .navbar {
      flex-wrap: wrap;
      gap: 20px;
      padding: 20px 16px;
    }

    .logo {
      width: 100%;
    }

    .links {
      width: 100%;
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 0;
    }

    a {
      font-size: clamp(12px, 3.2vw, 14px);
    }
  }
</style>
