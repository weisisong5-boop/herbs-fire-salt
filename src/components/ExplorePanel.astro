<section id="explore-content" class="explore-panel" aria-labelledby="explore-title">
  <div class="inner">
    <p class="eyebrow">Explore the journal</p>
    <h2 id="explore-title">Choose a path</h2>

    <div class="links">
      <a href="/field-notes/">
        <span class="number">01</span>
        <span class="entry">
          <span class="title">Field Notes</span>
          <span class="description">Plants, places, smoke, and weather.</span>
        </span>
      </a>

      <a href="/ingredients/">
        <span class="number">02</span>
        <span class="entry">
          <span class="title">Ingredients</span>
          <span class="description">Herbs, spices, produce, and pantry staples.</span>
        </span>
      </a>

      <a href="/recipes/">
        <span class="number">03</span>
        <span class="entry">
          <span class="title">Recipes</span>
          <span class="description">Simple cooking shaped by fire and salt.</span>
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  const explorePanel = document.querySelector(".explore-panel");

  if (explorePanel) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          explorePanel.classList.add("is-visible");
          observer.disconnect();
        }
      },
      { threshold: 0.28 },
    );

    observer.observe(explorePanel);
  }
</script>

