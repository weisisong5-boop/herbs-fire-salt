---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import ArchiveDetail from "../../components/ArchiveDetail.astro";

type Props = {
  entry: CollectionEntry<"ingredients">;
};

export async function getStaticPaths() {
  const entries = (await getCollection("ingredients")).filter((entry) => !entry.data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const title = `${entry.data.title} - Herbs - Fire - Salt`;
---

<BaseLayout title={title} description={entry.data.description}>
  <Navbar />
  <ArchiveDetail
    eyebrow="Ingredients"
    title={entry.data.title}
    secondary={entry.data.englishTitle}
    description={entry.data.description}
    cover={entry.data.cover}
  >
    <Content />
  </ArchiveDetail>
</BaseLayout>
