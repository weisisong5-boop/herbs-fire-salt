---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeroShell from "../../components/PageHeroShell.astro";
import SeasonalIndex from "../../components/SeasonalIndex.astro";
import { pageHeaders } from "../../config/pageHeaders";
import { byOrderThenTitle } from "../../lib/archive";
const entries = (await getCollection("ingredients")).filter((entry) => !entry.data.draft).sort(byOrderThenTitle);
---
<BaseLayout title="Ingredients - Herbs - Fire - Salt" description={pageHeaders.ingredients.subtitle} seasonTransition>
  <PageHeroShell {...pageHeaders.ingredients} sharedNavigation />
  <SeasonalIndex entries={entries} kind="ingredients" />
</BaseLayout>
