---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeroShell from "../../components/PageHeroShell.astro";
import ArchiveList from "../../components/ArchiveList.astro";
import ArchiveEntry from "../../components/ArchiveEntry.astro";
import { pageHeaders } from "../../config/pageHeaders";
import { byOrderThenTitle } from "../../lib/archive";

const title = "Ingredients - Herbs - Fire - Salt";
const description = "A growing index of herbs, spices, produce, and pantry staples.";
const ingredients = (await getCollection("ingredients"))
  .filter((ingredient) => !ingredient.data.draft)
  .sort(byOrderThenTitle);
---

<BaseLayout title={title} description={description}>
  <PageHeroShell {...pageHeaders.ingredients} />

  <ArchiveList label="Ingredient entries">
    {
      ingredients.length > 0 && (
        <>
        {ingredients.map((ingredient, index) => (
          <ArchiveEntry
            href={`/ingredients/${ingredient.id}/`}
            eyebrow={`Specimen / ${String(index + 1).padStart(2, "0")}`}
            title={ingredient.data.title}
            secondary={ingredient.data.englishTitle ?? ""}
            description={ingredient.data.description}
            image={ingredient.data.cover}
          />
        ))}
        </>
      )
    }
  </ArchiveList>
</BaseLayout>
