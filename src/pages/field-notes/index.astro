---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeroShell from "../../components/PageHeroShell.astro";
import ArchiveList from "../../components/ArchiveList.astro";
import ArchiveEntry from "../../components/ArchiveEntry.astro";
import { pageHeaders } from "../../config/pageHeaders";
import { byOrderThenDate } from "../../lib/archive";

const title = "Field Notes - Herbs - Fire - Salt";
const description = "Field notes on plants, places, and cooking traditions.";
const notes = (await getCollection("field-notes"))
  .filter((note) => !note.data.draft)
  .sort(byOrderThenDate);

const dateFormatter = new Intl.DateTimeFormat("en", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
---

<BaseLayout title={title} description={description}>
  <PageHeroShell {...pageHeaders.fieldNotes} />

  <ArchiveList label="Field Notes entries">
    {
      notes.map((note) => (
        <ArchiveEntry
          href={`/field-notes/${note.id}/`}
          eyebrow={dateFormatter.format(note.data.date)}
          title={note.data.title}
          secondary={`Location / ${note.data.location}`}
          description={note.data.description}
          image={note.data.cover}
        />
      ))
    }
  </ArchiveList>
</BaseLayout>
