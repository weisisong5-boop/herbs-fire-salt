---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeroShell from "../../components/PageHeroShell.astro";
import ArchiveList from "../../components/ArchiveList.astro";
import ArchiveEntry from "../../components/ArchiveEntry.astro";
import { pageHeaders } from "../../config/pageHeaders";
import { getPairings } from "../../lib/pairings";
const { notes } = await getPairings();
const hash = (id: string) => [...id].reduce((value, char) => (Math.imul(value, 31) + char.charCodeAt(0)) >>> 0, 0);
notes.sort((first, second) => hash(first.id) - hash(second.id) || first.id.localeCompare(second.id));
---
<BaseLayout title="Dish Inspiration - Herbs - Fire - Salt" description={pageHeaders.fieldNotes.subtitle}>
  <PageHeroShell {...pageHeaders.fieldNotes} />
  <ArchiveList label="Dish Inspiration entries">
    {notes.length ? notes.map((note) => <ArchiveEntry href={`/field-notes/${note.id}/`} eyebrow="Dish Inspiration" title={note.data.title} secondary="" description={note.data.description} image={note.data.cover} />) : <p>Stories are coming soon.</p>}
  </ArchiveList>
</BaseLayout>
