---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import ArchiveDetail from "../../components/ArchiveDetail.astro";
import { getPairings } from "../../lib/pairings";
type Props = { entry: CollectionEntry<"field-notes"> };
export async function getStaticPaths() {
  const { notes } = await getPairings();
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as Props;
const { recipeByNote } = await getPairings();
const recipe = recipeByNote.get(entry.id)!;
const { Content } = await render(entry);
---
<BaseLayout title={`${entry.data.title} - Herbs - Fire - Salt`} description={entry.data.description}>
  <Navbar />
  <ArchiveDetail eyebrow="Dish Inspiration" title={entry.data.title} description={entry.data.description} cover={entry.data.cover}>
    <Content />
    <div slot="related" class="related"><a href={`/recipes/${recipe.id}/`}>View the recipe: {recipe.data.title} →</a></div>
  </ArchiveDetail>
</BaseLayout>
<style>.related { border-top: 1px solid var(--color-line); padding-top: 24px; margin-top: 48px; } .related a { color: inherit; text-underline-offset: 5px; }</style>
