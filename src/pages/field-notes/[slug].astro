---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";

type Props = {
  note: CollectionEntry<"field-notes">;
};

export async function getStaticPaths() {
  const notes = await getCollection("field-notes");

  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props as Props;
const { Content } = await render(note);
const title = `${note.data.title} - Herbs - Fire - Salt`;
const dateFormatter = new Intl.DateTimeFormat("en", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
---

<BaseLayout title={title} description={note.data.description}>
  <Navbar />

  <article class="field-note">
    <header class="note-header">
      <p class="type">Field Notes</p>
      <h1>{note.data.title}</h1>
      <p class="summary">{note.data.description}</p>
      <div class="meta">
        <span>{note.data.location}</span>
        <span>{dateFormatter.format(note.data.date)}</span>
      </div>
    </header>

    {
      note.data.cover && (
        <figure class="cover">
          <img src={note.data.cover} alt="" />
        </figure>
      )
    }

    <div class="content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .field-note {
    width: min(1120px, calc(100% - 48px));
    margin: 0 auto;
    padding: 96px 0 120px;
  }

  .note-header {
    max-width: 860px;
    margin: 0 auto 72px;
    text-align: center;
  }

  .type {
    margin: 0 0 24px;
    color: var(--color-text-muted);
    font-size: 13px;
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--color-text-main);
    font-size: clamp(52px, 8vw, 96px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: 2px;
  }

  .summary {
    max-width: 680px;
    margin: 34px auto 0;
    color: var(--color-text-muted);
    font-size: 21px;
    line-height: 1.75;
  }

  .meta {
    display: flex;
    justify-content: center;
    gap: 22px;
    margin: 36px 0 0;
    color: var(--color-text-muted);
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .meta span + span::before {
    margin-right: 22px;
    content: "/";
    opacity: 0.45;
  }

  .cover {
    margin: 0 auto 88px;
  }

  .cover img {
    display: block;
    width: 100%;
    max-height: 680px;
    object-fit: cover;
  }

  .content {
    max-width: 720px;
    margin: 0 auto;
    color: var(--color-text-main);
    font-size: 20px;
    line-height: 1.85;
  }

  .content :global(p) {
    margin: 0 0 28px;
  }

  @media (max-width: 720px) {
    .field-note {
      padding: 68px 0 88px;
    }

    .note-header {
      margin-bottom: 54px;
    }

    .meta {
      flex-direction: column;
      gap: 10px;
    }

    .meta span + span::before {
      content: none;
    }

    .cover {
      margin-bottom: 58px;
    }
  }
</style>
