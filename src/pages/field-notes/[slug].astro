---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import ArchiveDetail from "../../components/ArchiveDetail.astro";

type Props = {
  entry: CollectionEntry<"field-notes">;
};

export async function getStaticPaths() {
  const entries = (await getCollection("field-notes")).filter((entry) => !entry.data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const title = `${entry.data.title} - Herbs - Fire - Salt`;
const date = new Intl.DateTimeFormat("en", {
  month: "long",
  day: "numeric",
  year: "numeric",
}).format(entry.data.date);
---

<BaseLayout title={title} description={entry.data.description}>
  <Navbar />
  <ArchiveDetail
    eyebrow="Field Notes"
    title={entry.data.title}
    secondary={`${entry.data.location} · ${date}`}
    description={entry.data.description}
    cover={entry.data.cover}
  >
    <Content />
  </ArchiveDetail>
</BaseLayout>
