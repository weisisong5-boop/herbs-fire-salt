---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import SeasonCover from "../components/SeasonCover.astro";
---
<BaseLayout title="Herbs - Fire - Salt" showFooter={false} seasonTransition>
  <div class="home">
    <div class="home-navigation"><Navbar transparent /></div>
    <SeasonCover />
  </div>
</BaseLayout>
<style>
  .home {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
  }
  .home-navigation {
    position: absolute;
    z-index: 2;
    inset: 0 0 auto;
    text-shadow: 0 1px 8px #171b13;
    view-transition-name: season-navigation;
  }
</style>
