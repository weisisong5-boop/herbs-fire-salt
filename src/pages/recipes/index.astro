---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeroShell from "../../components/PageHeroShell.astro";
import ArchiveList from "../../components/ArchiveList.astro";
import ArchiveEntry from "../../components/ArchiveEntry.astro";
import { pageHeaders } from "../../config/pageHeaders";
import { byOrderThenTitle } from "../../lib/archive";

const title = "Recipes - Herbs - Fire - Salt";
const description = "Simple recipes shaped by plants, fire, salt, and place.";
const recipes = (await getCollection("recipes"))
  .filter((recipe) => !recipe.data.draft)
  .sort(byOrderThenTitle);
---

<BaseLayout title={title} description={description}>
  <PageHeroShell {...pageHeaders.recipes} />

  <ArchiveList label="Recipe entries">
    {
      recipes.length > 0 && (
        <>
        {recipes.map((recipe, index) => (
          <ArchiveEntry
            href={`/recipes/${recipe.id}/`}
            eyebrow={`Recipe Study / ${String(index + 1).padStart(2, "0")}`}
            title={recipe.data.title}
            secondary={recipe.data.englishTitle ?? ""}
            description={recipe.data.description}
            image={recipe.data.cover}
          />
        ))}
        </>
      )
    }
  </ArchiveList>
</BaseLayout>
